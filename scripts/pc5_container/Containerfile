# OpenFOAM for pc5 (friend's PC, Ubuntu 26.04 host; the pinned OpenFOAM build exists only for 24.04).
# Same packages and versions as the lab, pc3 and pc4 (pc4_setup.sh), so results are identical.
# Built rootless by pc5_container.sh; runs as the host user with the host home mounted.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg build-essential \
      python3 python3-numpy python3-h5py procps gzip && \
    curl -fsSL https://dl.openfoam.com/add-debian-repo.sh | bash && \
    apt-get install -y openfoam2606-default=2606.0~rc2-1 openfoam2606=2606.0~rc2-1 openfoam2606-common=2606.0~rc2-1 \
      openfoam2606-dev=2606.0~rc2-1 openfoam2606-tools=2606.0~rc2-1 && \
    apt-mark hold openfoam2606 openfoam2606-common openfoam2606-default openfoam2606-dev openfoam2606-tools && \
    rm -rf /var/lib/apt/lists/*
